{
  "name": "claude-mcp-server",
  "version": "1.0.0",
  "private": true,
  "description": "Local MCP server indexing Anthropic's docs, so Claude looks up its own current instructions instead of relying on memory",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "fetch-docs": "tsx scripts/fetch-docs.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  }
}
